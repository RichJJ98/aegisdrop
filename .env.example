# Copie para .env (que está no .gitignore) e preencha. NUNCA versione valores reais.

# Token do operador da Central. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CENTRAL_API_KEY=coloque_uma_chave_segura_aqui
CENTRAL_OPERATOR_ID=operador_central_01
PORT=3000

# Chave mestra AES-256-GCM (cifra descrições, contatos e observações).
# 64 caracteres hexadecimais = 32 bytes. Mesmo comando acima gera uma.
# Em produção, injete via secret manager/KMS; com NODE_ENV=production o
# servidor se recusa a subir sem ela (não gera chave automaticamente).
# Alternativa: AEGIS_MASTER_KEY_FILE=/caminho/fora/do/projeto/master.key
# Em desenvolvimento, sem nenhuma das duas, uma chave local é gerada em
# data/master.key (ignorada pelo git).
AEGIS_MASTER_KEY=
